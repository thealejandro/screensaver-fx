<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Screensaver FX</title>
  <organization>dev.thealejandro</organization>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <!-- Claro: solo el icono; oscuro: la imagen estrellada del instalador de Windows. -->
  <background file="pkg-mark.png" alignment="bottomleft" scaling="none"/>
  <background-darkAqua file="pkg-background.png" alignment="bottomleft" scaling="proportional"/>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <volume-check>
    <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="saver"/>
  </choices-outline>
  <choice id="saver" visible="false">
    <pkg-ref id="dev.thealejandro.ScreensaverFX"/>
  </choice>
  <pkg-ref id="dev.thealejandro.ScreensaverFX" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
