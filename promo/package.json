{
  "name": "screensaver-fx-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeos promocionales de Screensaver FX (Remotion)",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "clips": "python3 -I scripts/clips.py",
    "audio": "for f in reel wide estado; do python3 -I scripts/audio/musica.py muestras/ir --format $f || exit 1; done",
    "build": "bash scripts/build.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
