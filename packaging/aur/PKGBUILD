pkgname=screensaver-fx-bin
pkgver=0.1.16
pkgrel=1
pkgdesc='Terminal screensaver with 41 effects (standalone binary of Screensaver FX)'
arch=('x86_64' 'aarch64')
url='https://github.com/thealejandro/screensaver-fx'
license=('MIT')
provides=('screensaver-fx')
conflicts=('screensaver-fx')
_rel="$url/releases/download/v$pkgver"
source=("LICENSE::https://raw.githubusercontent.com/thealejandro/screensaver-fx/v$pkgver/LICENSE")
source_x86_64=("screensaver-fx-$pkgver-x86_64::$_rel/screensaver-fx-linux-x86_64")
source_aarch64=("screensaver-fx-$pkgver-aarch64::$_rel/screensaver-fx-linux-aarch64")
sha256sums=('SKIP')
sha256sums_x86_64=('20849d2c3b710f393015f4d36eb2cd39cc0a00c759fa784acd8c95bbe9c6a062')
sha256sums_aarch64=('d5b38703932a29b2b55ee9e2e377bb517dba3679eca06d56d7f9bf43beea00ea')

package() {
  install -Dm755 "screensaver-fx-$pkgver-$CARCH" "$pkgdir/usr/bin/screensaver-fx"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
